PORT=3000
# Use a strong random value. Never use the example value in a real environment.
JWT_SECRET=replace-with-a-strong-random-secret
# false for local HTTP development; true for HTTPS deployments.
COOKIE_SECURE=false
SERVE_STATIC=false
DATA_ROOT=./data

# MySQL 8.0 local connection. Create a server-nest/.env file from this example.
# Docker Compose keeps using your host machine MySQL and overrides MYSQL_HOST to host.docker.internal.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=eduflow_course_admin
MYSQL_CONNECTION_LIMIT=10
# Auto-run TypeORM migrations on app startup. Keep false in production and run migrations explicitly.
TYPEORM_MIGRATIONS_RUN=true

# Optional: used only by scripts/migrate-sqlite-to-mysql.mjs.
SQLITE_DB_PATH=../server/data/homework.db

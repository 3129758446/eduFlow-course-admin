PORT=3000
JWT_SECRET=change-me-in-production
SERVE_STATIC=false
DATA_ROOT=../server/data

# MySQL 8.0 local connection. Create a server-nest/.env file from this example.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=eduflow_course_admin
MYSQL_CONNECTION_LIMIT=10

# Optional: used only by scripts/migrate-sqlite-to-mysql.mjs.
SQLITE_DB_PATH=../server/data/homework.db
